APP_NAME="FTS Corporate AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Display timezone (config/corporate.php). Timestamps are stored in UTC.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=corporate_ai
DB_USERNAME=corporate_ai
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Retention in days (config/corporate.php)
RETENTION_CONVERSATIONS_DAYS=90
RETENTION_TICKETS_DAYS=365
RETENTION_AUDIT_DAYS=365

# Scene images: local (final illustrations in public/assets/corporate) or placeholder (dev only)
SCENE_IMAGE_SOURCE=local
SCENE_PLACEHOLDER_BASE_URL=https://picsum.photos

ASSISTANT_ENABLED=false
# Tool calling (search, own tickets, ticket drafts). false for providers without function calling.
ASSISTANT_TOOLS_ENABLED=true
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
# Optional provider capability, e.g. "none" for thinking models (LM Studio Qwen3).
ASSISTANT_REASONING_EFFORT=
# Optional CA bundle file for TLS to the provider (when PHP has no CA configured).
LOCAL_LLM_CA_BUNDLE=

VITE_APP_NAME="${APP_NAME}"
