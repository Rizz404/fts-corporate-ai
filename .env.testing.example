# Copy to .env.testing (untracked) for `composer test`. PostgreSQL 17 is the
# test baseline; the database name must end with "_test" (TestDatabaseGuard).
#   CREATE ROLE corporate_ai LOGIN PASSWORD '...';
#   CREATE DATABASE corporate_ai_test OWNER corporate_ai;
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=corporate_ai_test
DB_USERNAME=corporate_ai
DB_PASSWORD=

# The real provider is never called by tests (Http::fake / FakeModelGateway).
ASSISTANT_ENABLED=false
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
SCENE_IMAGE_SOURCE=local
