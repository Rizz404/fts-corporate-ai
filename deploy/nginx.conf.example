# FTS Corporate AI — nginx site template (PLAN_08).
# Replace corporate.example.com, certificate paths, the release path, and the
# PHP-FPM socket. Only public/index.php is executed; dotfiles and .env are
# never served. fastcgi_read_timeout (80 s) is longer than the 60 s AI turn
# deadline and the 75 s lease.

server {
    listen 80;
    listen [::]:80;
    server_name corporate.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name corporate.example.com;

    ssl_certificate     /etc/ssl/certs/corporate.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/corporate.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root /var/www/corporate-ai/current/public;
    index index.php;
    charset utf-8;
    client_max_body_size 2m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Never serve dotfiles (.env, .git, ...), except ACME challenges.
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The only PHP entry point.
    location = /index.php {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 80s;
    }

    # Any other .php file is not executed.
    location ~ \.php$ {
        return 404;
    }

    error_page 404 /index.php;
}
