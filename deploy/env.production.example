# FTS Corporate AI — production environment template (PLAN_08).
# Copy to the server's shared .env (mode 0600, owned by the deploy user).
# Never commit real values. Fill every <...>.

APP_NAME="FTS Corporate AI"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17, reachable only from the app/worker hosts.
DB_CONNECTION=pgsql
DB_HOST=<db-host>
DB_PORT=5432
DB_DATABASE=corporate_ai
DB_USERNAME=corporate_ai
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# v1 notifications are synchronous; set true only when queued jobs exist.
QUEUE_WORKER_REQUIRED=false

MAIL_MAILER=log

RETENTION_CONVERSATIONS_DAYS=90
RETENTION_TICKETS_DAYS=365
RETENTION_AUDIT_DAYS=365

# Production always serves the local illustrations.
SCENE_IMAGE_SOURCE=local

# AI provider (HTTPS required in production; base URL without /v1).
ASSISTANT_ENABLED=true
ASSISTANT_TOOLS_ENABLED=true
LOCAL_LLM_BASE_URL=https://<provider-host>
LOCAL_LLM_API_KEY=<secret>
LOCAL_LLM_MODEL=<model-alias>
ASSISTANT_REASONING_EFFORT=
LOCAL_LLM_CA_BUNDLE=
